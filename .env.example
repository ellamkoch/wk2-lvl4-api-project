PORT=3005
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Database configuration
DB_PATH=your_db_path_here

# Supabase Project database pw
SUPABASE_DB_PASSSWORD=super_long_strong_password_here

# Prisma SQL Supabase pw
PRISMA_SQL_SUPABASE_PASSWORD=super_long_strong_password_here

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.your_supabase_user:super_long_strong_password_here"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.your_supabase_user:super_long_strong_password_here"

# Local dev queries
PRISMA_LOG_QUERIES=true
